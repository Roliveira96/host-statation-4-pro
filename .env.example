# Copie para .env e preencha. O .env nunca vai para o Git.

# Domínio na Cloudflare
DOMINIO=exemplo.com.br

# Senha do root do MariaDB. Gere com: openssl rand -base64 24
MARIADB_ROOT_PASSWORD=troque-isto

# Token do Cloudflare Tunnel (painel da Cloudflare > Networks > Tunnels >
# Create a tunnel > Cloudflared > o texto depois de --token)
CLOUDFLARE_TUNNEL_TOKEN=
